#!/usr/bin/env bash
set -euo pipefail
PATH="$HOME/.local/bin:$PATH"

favorites="${XDG_CONFIG_HOME:-$HOME/.config}/tinted-theming/favorites"
current=$(tinty current 2>/dev/null || true)

favs=$(cat "$favorites" 2>/dev/null || true)

out=$(tinty list --json | jq -r --arg cur "$current" --arg favs "$favs" '
    ($favs | split("\n") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))) as $f
    | map(select(.system == "base16" or .system == "base24")
          | {id, label: "\(.name)  ·  \(.variant)  ·  \(.system)"})
    | INDEX(.id) as $by
    | [$f[] | $by[.] | select(.)] as $favrows
    | ($favrows + (map(select(.id as $i | $f | index($i) | not))
                   | sort_by(.label | ascii_downcase))) as $rows
    | "\(($rows | map(.id) | index($cur)) // 0)\t\([range($favrows | length)] | join(","))",
      ($rows[] | "\(.label)\t\(.id)")')

meta=${out%%$'\n'*}
menu=${out#*$'\n'}
selected=${meta%%$'\t'*}
active=${meta#*$'\t'}

active_arg=()
[ -n "$active" ] && active_arg=(-a "$active")

choice=$(printf '%s' "$menu" | rofi -dmenu -i -p theme \
    -display-columns 1 -display-column-separator $'\t' \
    -selected-row "$selected" "${active_arg[@]}") || exit 0

id=${choice##*$'\t'}
[ -n "$id" ] || exit 0

tinty apply "$id"
notify-send -a theme -t 2500 "Theme" "$(tinty current name)"

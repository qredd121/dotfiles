#!/usr/bin/env bash
set -euo pipefail
PATH="$HOME/.local/bin:$PATH"

favorites="${XDG_CONFIG_HOME:-$HOME/.config}/tinted-theming/favorites"
current=$(tinty current 2>/dev/null || true)

schemes=$(tinty list --json | jq -r '
    .[]
    | select(.system == "base16" or .system == "base24")
    | [.id, "\(.name)  ·  \(.variant)  ·  \(.system)"]
    | @tsv' | sort -t $'\t' -k2,2f)

fav_ids=()
[ -f "$favorites" ] && mapfile -t fav_ids < <(grep -v '^[[:space:]]*$' "$favorites")

menu=""
active=()
selected=0
row=0

add() {
    menu+="$2"$'\t'"$1"$'\n'
    [ "$1" = "$current" ] && selected=$row
    row=$((row + 1))
}

for id in "${fav_ids[@]}"; do
    line=$(awk -F'\t' -v id="$id" '$1 == id { print; exit }' <<< "$schemes")
    [ -n "$line" ] || continue
    active+=("$row")
    add "$id" "${line#*$'\t'}"
done

while IFS=$'\t' read -r id label; do
    printf '%s\n' "${fav_ids[@]}" | grep -qxF "$id" && continue
    add "$id" "$label"
done <<< "$schemes"

active_arg=()
[ ${#active[@]} -gt 0 ] && active_arg=(-a "$(IFS=,; echo "${active[*]}")")

choice=$(printf '%s' "$menu" | rofi -dmenu -i -p theme \
    -display-columns 1 -display-column-separator $'\t' \
    -selected-row "$selected" "${active_arg[@]}") || exit 0

id=${choice##*$'\t'}
[ -n "$id" ] || exit 0

tinty apply "$id"
notify-send -a theme -t 2500 "Theme" "$(tinty current name)"

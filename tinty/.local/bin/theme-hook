#!/usr/bin/env bash
set -u

data="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
file="${TINTY_THEME_FILE_PATH:-}"
variant="${TINTY_SCHEME_VARIANT:-dark}"
[ "$variant" = light ] || variant=dark

live() { [ "${TINTY_THEME_OPERATION:-apply}" = apply ]; }

link() {
    mkdir -p "$(dirname "$2")"
    ln -sfn "$1" "$2"
}

put() {
    mkdir -p "$(dirname "$2")"
    cp -f "$1" "$2.tmp" && mv -f "$2.tmp" "$2"
}

ini_set() {
    local f=$1 section=$2 key=$3 value=$4
    grep -q "^\[$section\]" "$f" || printf '\n[%s]\n' "$section" >> "$f"
    if grep -q "^$key=" "$f"; then
        sed -i "s|^$key=.*|$key=$value|" "$f"
    else
        sed -i "/^\[$section\]/a $key=$value" "$f"
    fi
}

foot_live() {
    local esc=$'\e' st=$'\e\\' seq="" k v rgb pid child tty
    while IFS='=' read -r k v; do
        v=${v%%#*}
        v=${v//[[:space:]]/}
        [[ $v =~ ^[0-9a-fA-F]{6}$ ]] || continue
        rgb="rgb:${v:0:2}/${v:2:2}/${v:4:2}"
        case $k in
            foreground) seq+="${esc}]10;${rgb}${st}" ;;
            background) seq+="${esc}]11;${rgb}${st}" ;;
            regular[0-7]) seq+="${esc}]4;${k#regular};${rgb}${st}" ;;
            bright[0-7]) seq+="${esc}]4;$((${k#bright} + 8));${rgb}${st}" ;;
            1[6-9] | 2[01]) seq+="${esc}]4;${k};${rgb}${st}" ;;
        esac
    done < "$1"
    seq+="${esc}]112${st}"

    for pid in $(pgrep -u "$USER" -x foot); do
        for child in $(pgrep -P "$pid"); do
            tty=$(readlink "/proc/$child/fd/0" 2>/dev/null) || continue
            [[ $tty == /dev/pts/* ]] && [ -w "$tty" ] && printf '%s' "$seq" > "$tty"
        done
    done
}

case "${1:-}" in
    foot)
        live && foot_live "$file"
        ;;
    tmux)
        live && tmux has-session 2>/dev/null && tmux source-file "$file"
        ;;
    zed)
        mkdir -p "$cfg/zed/themes"
        jq '.name = "Tinty" | .themes[0].name = "Tinty"' "$file" > "$cfg/zed/themes/tinty.json.tmp" &&
            mv -f "$cfg/zed/themes/tinty.json.tmp" "$cfg/zed/themes/tinty.json"
        ;;
    waybar)
        link "$data/waybar-build-waybar-file.css" "$cfg/waybar/theme.css"
        live && pkill -USR2 -x waybar
        ;;
    dunst)
        link "$data/dunst-build-dunst-file.conf" "$cfg/dunst/dunstrc.d/90-theme.conf"
        live && pgrep -u "$USER" -x dunst > /dev/null && dunstctl reload
        ;;
    gtk3)
        link "$data/gtk3-build-gtk3-file.css" "$cfg/gtk-3.0/gtk.css"
        if [ "$variant" = dark ]; then
            gsettings set org.gnome.desktop.interface color-scheme prefer-dark
            gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
            gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark
        else
            gsettings set org.gnome.desktop.interface color-scheme prefer-light
            gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3
            gsettings set org.gnome.desktop.interface icon-theme Papirus-Light
        fi
        ;;
    gtk4)
        link "$data/gtk4-build-gtk4-file.css" "$cfg/gtk-4.0/gtk.css"
        ;;
    qt6ct)
        conf="$cfg/qt6ct/qt6ct.conf"
        mkdir -p "$cfg/qt6ct"
        [ -f "$conf" ] || printf '[Appearance]\n' > "$conf"
        ini_set "$conf" Appearance style Fusion
        ini_set "$conf" Appearance custom_palette true
        ini_set "$conf" Appearance color_scheme_path "$data/qt6ct-build-qt6ct-file.conf"
        if [ "$variant" = dark ]; then
            ini_set "$conf" Appearance icon_theme Papirus-Dark
        else
            ini_set "$conf" Appearance icon_theme Papirus-Light
        fi
        ;;
    swaylock)
        cat "$cfg/swaylock/base.conf" "$file" > "$cfg/swaylock/config.tmp" 2>/dev/null &&
            mv -f "$cfg/swaylock/config.tmp" "$cfg/swaylock/config"
        ;;
    vesktop)
        put "$file" "$cfg/vesktop/themes/tinty.css"
        ;;
    sway)
        if live && pgrep -u "$USER" -x sway > /dev/null; then
            if [ -z "${SWAYSOCK:-}" ]; then
                SWAYSOCK=$(ls "/run/user/$(id -u)"/sway-ipc.*.sock 2>/dev/null | head -n1)
                export SWAYSOCK
            fi
            swaymsg -q -- "$(sed 's/$/;/' "$file")"
        fi
        ;;
    *)
        echo "usage: theme-hook {foot|tmux|zed|waybar|dunst|gtk3|gtk4|qt6ct|swaylock|vesktop|sway}" >&2
        exit 2
        ;;
esac
exit 0

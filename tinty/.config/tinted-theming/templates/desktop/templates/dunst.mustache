[global]
    frame_color = "#{{base0D-hex}}"
    separator_color = frame
    highlight = "#{{base0D-hex}}"

[urgency_low]
    background = "#{{base00-hex}}"
    foreground = "#{{base04-hex}}"
    frame_color = "#{{base02-hex}}"

[urgency_normal]
    background = "#{{base00-hex}}"
    foreground = "#{{base05-hex}}"
    frame_color = "#{{base0D-hex}}"

[urgency_critical]
    background = "#{{base00-hex}}"
    foreground = "#{{base05-hex}}"
    frame_color = "#{{base08-hex}}"
